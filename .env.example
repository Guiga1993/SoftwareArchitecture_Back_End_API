# CONFIGURATION TEMPLATE ONLY - copy to .env for local backend execution.
# The backend does not store Shippo credentials; it calls the integration API.
SHIPPO_INTEGRATION_BASE_URL=http://127.0.0.1:8001

# Optional explicit connect/read timeout values in seconds.
SHIPPO_INTEGRATION_CONNECT_TIMEOUT_SECONDS=3.05
SHIPPO_INTEGRATION_READ_TIMEOUT_SECONDS=30